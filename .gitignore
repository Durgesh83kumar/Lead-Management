# ==========================================
# Git Ignore Configuration - Masal AI
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.env
firebase_credentials*.json
serviceAccountKey*.json
firebase_admin*.json

# Vercel serverless deployment
.vercel/

# Development, test & benchmark folders
data/
mockup/
examples/
tests/
test/

# Python compiled files & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
env/
venv/
ENV/
.venv/

# Local database cache & runtime data
leads_db.json
*.db
*.sqlite3

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Node / frontend caches (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
